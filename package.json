{
  "name": "worknaru",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "worknaru": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:daemon && npm run build:web",
    "build:prototype": "tsc -p tsconfig.web.json && vite build --config vite.prototype.config.ts",
    "preview:prototype": "vite preview --config vite.prototype.config.ts --host 127.0.0.1 --port 15176 --strictPort",
    "build:web": "tsc -p tsconfig.web.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "dev:web": "vite",
    "preview:web": "vite preview",
    "start": "node dist/main.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "chat": "node dist/chat-client.js",
    "test:live": "npm run build && node --test tests/live-acp.mjs",
    "test:web": "npm run build && playwright test",
    "test:web:live": "npm run build && node --test tests/web-live.mjs",
    "test:files:live": "npm run build && node --test tests/files-live.mjs",
    "build:daemon": "tsc",
    "rpc": "node dist/rpc-client.js",
    "test:runtime": "npm run build:daemon && node --test tests/paseo-runtime.test.mjs",
    "test:live:paseo": "npm run build:daemon && node --test tests/paseo-live.mjs",
    "test:daemon": "npm run build:daemon && node --test tests/daemon.test.mjs tests/acp.test.mjs tests/settings.test.mjs tests/file-tools.test.mjs tests/web-client.test.mjs tests/rpc-client.test.mjs tests/cli.test.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.10.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@getpaseo/client": "0.8.0-beta.1",
    "@getpaseo/server": "0.8.0-beta.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "4.17.25",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
